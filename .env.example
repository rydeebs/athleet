SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# US / USD Stripe Connect pilot. Server-only values; never use VITE_ or public prefixes.
# Start with test keys. Keep PAYMENTS_ENABLED=false until setup and webhook/cron tests pass.
APP_URL=http://localhost:4174
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
CRON_SECRET=
# Comma-separated Supabase user UUIDs allowed to resolve disputed bookings.
PAYMENT_ADMIN_USER_IDS=
PAYMENTS_ENABLED=false
# Set only after live Connect approval, policy review, and successful test-mode lifecycle tests.
PAYMENTS_LIVE_APPROVED=false

# Transactional payment notices (separate from Supabase Auth SMTP).
RESEND_API_KEY=
PAYMENTS_FROM_EMAIL=enduur <accounts@enduur.co>
