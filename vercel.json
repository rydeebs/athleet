{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/audience.js": {
      "maxDuration": 30
    },
    "api/payments.js": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 60
    },
    "api/payments-cron.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(app.js|style.css|audience.mjs|races.mjs|portal.js|portal.css|sponsor.css|sponsor.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(assets/athletes/v1|assets/athletes/v2|assets/vision/v1|chunks)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/athletes",
      "destination": "/portal.html"
    },
    {
      "source": "/sponsors",
      "destination": "/portal.html"
    },
    {
      "source": "/for-sponsors",
      "destination": "/sponsor.html"
    },
    {
      "source": "/invite",
      "destination": "/invite-athletes.html"
    },
    {
      "source": "/invite/athletes",
      "destination": "/invite-athletes.html"
    },
    {
      "source": "/invite/brands",
      "destination": "/invite-brands.html"
    }
  ],
  "crons": [
    {
      "path": "/api/payments-cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
